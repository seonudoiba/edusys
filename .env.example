# Local development settings (Laragon). Copy to .env in the project folder and adjust:
#   copy .env.example .env        (PowerShell / cmd)
# Read by application/env_loader.php for any setting the web server or shell hasn't set.
# .env is ignored by git and refused by the web server. Never put production secrets here:
# the server uses /etc/edusys/edusys.env (deploy/edusys.env.example).

# Tenancy: <subdomain>.edusys_ng.test opens a school (add the names to the Windows hosts file)
EDUSYS_BASE_DOMAIN=edusys_ng.test
EDUSYS_CENTRAL_HOST=edusys_ng.test
EDUSYS_TENANCY_RAW_SQL=log

# Database (Laragon's MySQL; an empty password is allowed: EDUSYS_DB_PASSWORD=)
EDUSYS_DB_HOST=127.0.0.1
EDUSYS_DB_PORT=3306
EDUSYS_DB_NAME=edusys
EDUSYS_DB_USER=root
EDUSYS_DB_PASSWORD=

# Mail goes to Laragon's Mailpit: inbox at http://127.0.0.1:8025
EDUSYS_SMTP_HOST=127.0.0.1
EDUSYS_SMTP_PORT=1025
EDUSYS_SMTP_USER=
EDUSYS_SMTP_PASS=

# Payments: a Paystack TEST key (sk_test_...) when testing online payment
EDUSYS_PAYSTACK_SECRET_KEY=

# Platform > Backups folder (optional; default application/backups)
# EDUSYS_BACKUP_DIR=C:/laragon/backups/edusys
