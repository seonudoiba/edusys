# Edusys scheduled jobs: one set of lines for the whole platform (cron_all runs every school).
# Install for the web server user (or a dedicated user that can read the app and reach MySQL):
#   crontab -u www-data deploy/crontab.example     (after editing paths)
# The CLI does not see Apache's SetEnv values, so the environment is set here.

EDUSYS_DB_HOST=127.0.0.1
EDUSYS_DB_PORT=3306
EDUSYS_DB_NAME=edusys
EDUSYS_DB_USER=edusys_app
EDUSYS_DB_PASSWORD=change-me
EDUSYS_BASE_DOMAIN=edusys_ng.test
EDUSYS_CENTRAL_HOST=edusys_ng.test,www.edusys_ng.test
EDUSYS_FORCE_HTTPS=true
EDUSYS_TENANCY_RAW_SQL=throw
EDUSYS_SMTP_HOST=smtp.mailgun.org
EDUSYS_SMTP_PORT=587
EDUSYS_SMTP_USER=postmaster@edusys.ng
EDUSYS_SMTP_PASS=change-me

# Absent marking for sections whose attendance cut-off has passed.
*/5 * * * *  cd /var/www/edusys && php index.php cron_all run student_attendance >> /var/log/edusys-cron.log 2>&1

# Daily jobs: fee reminders, event reminders, scheduled messages.
0 6 * * *    cd /var/www/edusys && php index.php cron_all run >> /var/log/edusys-cron.log 2>&1
# Platform: subscription renewal reminders and expiry notices (once a day, not per school).
15 6 * * *   cd /var/www/edusys && php index.php platform_cron reminders >> /var/log/edusys-cron.log 2>&1

# Scheduled e-mail/SMS messages are also sent by the daily run; send them more often if needed:
# */10 * * * * cd /var/www/edusys && php index.php cron_all run schedulesmsemails >> /var/log/edusys-cron.log 2>&1

# Database backup (one dump of the shared database, kept 14 days). Backups are a platform task;
# schools can no longer back up or restore from the admin panel.
30 2 * * *   mysqldump --single-transaction --routines -h 127.0.0.1 -u edusys_backup edusys | gzip > /var/backups/edusys/edusys-$(date +\%F).sql.gz && find /var/backups/edusys -name 'edusys-*.sql.gz' -mtime +14 -delete
# Every school's files (uploads/s<id>/), kept 14 days like the database dumps.
45 2 * * *   tar -czf /var/backups/edusys/uploads-$(date +\%F).tar.gz -C /var/www/edusys uploads && find /var/backups/edusys -name 'uploads-*.tar.gz' -mtime +14 -delete
