-- Edusys database and least-privilege accounts (run once as a MySQL administrator).
-- Replace the passwords. The application never needs global privileges.

CREATE DATABASE IF NOT EXISTS edusys CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;

-- Application account (web requests and cron). Schema changes run with this account too
-- (php index.php migrate), so it needs DDL on this database only.
CREATE USER IF NOT EXISTS 'edusys_app'@'127.0.0.1' IDENTIFIED BY 'change-me';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES, LOCK TABLES
    ON edusys.* TO 'edusys_app'@'127.0.0.1';

-- Backup account (nightly mysqldump: deploy/backup.sh). Use the same passwords in /etc/edusys/edusys.env.
CREATE USER IF NOT EXISTS 'edusys_backup'@'127.0.0.1' IDENTIFIED BY 'change-me-too';
GRANT SELECT, LOCK TABLES, SHOW VIEW, TRIGGER, EVENT ON edusys.* TO 'edusys_backup'@'127.0.0.1';

FLUSH PRIVILEGES;
