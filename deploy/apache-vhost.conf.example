# Edusys: one virtual host for the platform (edusys.ng) and every school (<subdomain>.edusys.ng).
# server-setup.sh installs it as /etc/apache2/sites-available/edusys.conf once the certificate
# exists (before that it uses apache-vhost-http.conf.example).
#
# DNS: an A (and AAAA) record for edusys.ng and a wildcard *.edusys.ng, both pointing at this server.
# TLS: one certificate covering edusys.ng and *.edusys.ng. Wildcards need the DNS-01 challenge, e.g.
#   certbot certonly --manual --preferred-challenges dns -d edusys.ng -d '*.edusys.ng'
# or a certbot DNS plugin for your DNS provider, so renewals are automatic.
#
# Settings and secrets are NOT in this file: Apache gets them from /etc/edusys/edusys.env through
# systemd (server-setup.sh adds EnvironmentFile to apache2.service), and PHP reads them with getenv().

<VirtualHost *:80>
    ServerName edusys.ng
    ServerAlias www.edusys.ng *.edusys.ng
    # Everything over HTTPS (keeps the requested host, so schools stay on their subdomain).
    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName edusys.ng
    ServerAlias www.edusys.ng *.edusys.ng
    # The live release (deploy/release.sh switches this link).
    DocumentRoot /var/www/edusys/current

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/edusys.ng/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/edusys.ng/privkey.pem

    <Directory /var/www/edusys>
        AllowOverride All
        Require all granted
        Options -Indexes +FollowSymLinks
    </Directory>

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"

    ErrorLog  ${APACHE_LOG_DIR}/edusys-error.log
    CustomLog ${APACHE_LOG_DIR}/edusys-access.log combined
</VirtualHost>

# Schools' own domains (Schools > a school > Custom domains). Uncomment once a school uses one;
# give each domain a certificate (certbot --apache -d portal.school.com) or put them on one SAN
# certificate. Only verified domains open a school; any other host gets 404.
#
# <VirtualHost *:443>
#     ServerName custom-domains.invalid
#     ServerAlias *
#     DocumentRoot /var/www/edusys/current
#     SSLEngine on
#     SSLCertificateFile    /etc/letsencrypt/live/custom-domains/fullchain.pem
#     SSLCertificateKeyFile /etc/letsencrypt/live/custom-domains/privkey.pem
#     <Directory /var/www/edusys>
#         AllowOverride All
#         Require all granted
#         Options -Indexes +FollowSymLinks
#     </Directory>
# </VirtualHost>
