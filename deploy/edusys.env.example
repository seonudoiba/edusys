# Edusys server environment: /etc/edusys/edusys.env (root:www-data, mode 640).
# Read by Apache (systemd EnvironmentFile, see server-setup.sh), by cron and by deployments
# (deploy/run.sh, deploy/release.sh). One KEY=value per line, no spaces around "=".
# Quote values containing spaces, '#' or '$' with single quotes: KEY='va$lue'.
# After changing it: sudo systemctl restart apache2

# Tenancy
EDUSYS_BASE_DOMAIN=edusys.ng
EDUSYS_CENTRAL_HOST=edusys.ng,www.edusys.ng
EDUSYS_FORCE_HTTPS=true
EDUSYS_TENANCY_RAW_SQL=throw

# Database: the application account from deploy/mysql-setup.sql.example (never root)
EDUSYS_DB_HOST=127.0.0.1
EDUSYS_DB_PORT=3306
EDUSYS_DB_NAME=edusys
EDUSYS_DB_USER=edusys_app
EDUSYS_DB_PASSWORD=change-me

# Nightly dumps (deploy/backup.sh): the read-only backup account
EDUSYS_BACKUP_DB_USER=edusys_backup
EDUSYS_BACKUP_DB_PASSWORD=change-me-too

# Platform > Backups and the pre-deployment dumps
EDUSYS_BACKUP_DIR=/var/backups/edusys/app



# ---------------------------------------------------------------------------------------------
# Platform payment gateways: how SCHOOLS pay YOU for plans (registration and renewal pages).
# A gateway appears on those pages once its required settings below are filled in.
# Leave a gateway's values empty to hide it. Test keys first; see PAYMENTS_SETUP.md.
# ---------------------------------------------------------------------------------------------
# Currency of the plans
EDUSYS_PLATFORM_CURRENCY=NGN

# Paystack: dashboard.paystack.com > Settings > API Keys & Webhooks (sk_test_... or sk_live_...)
# (the key decides test or live). Also lets schools use subaccounts for fees.
EDUSYS_PAYSTACK_SECRET_KEY=

# Flutterwave: dashboard.flutterwave.com > Settings > API Keys (FLWSECK_TEST-... or FLWSECK-...)
# (the key decides test or live). Also lets schools use subaccounts for fees.
EDUSYS_FLUTTERWAVE_SECRET_KEY=
EDUSYS_FLUTTERWAVE_PUBLIC_KEY=

# Monnify: app.monnify.com > Developer > API Keys & Contracts. LIVE=true for production keys.
EDUSYS_MONNIFY_API_KEY=
EDUSYS_MONNIFY_SECRET_KEY=
EDUSYS_MONNIFY_CONTRACT_CODE=
EDUSYS_MONNIFY_LIVE=false

# Interswitch: business.quickteller.com > Developer Tools. LIVE=true for production.
EDUSYS_INTERSWITCH_MERCHANT_CODE=
EDUSYS_INTERSWITCH_PAY_ITEM_ID=
EDUSYS_INTERSWITCH_LIVE=false

# Remita: remita.net, your profile's integration details. LIVE=true for production.
EDUSYS_REMITA_MERCHANT_ID=
EDUSYS_REMITA_SERVICE_TYPE_ID=
EDUSYS_REMITA_API_KEY=
EDUSYS_REMITA_LIVE=false

# School fees through subaccounts: your share of each payment, in percent (0 = the school gets it all,
# less the gateway's fee). Applied when a subaccount is created.
EDUSYS_PLATFORM_SPLIT_PERCENT=0

# Outgoing mail
EDUSYS_SMTP_HOST=smtp.mailgun.org
EDUSYS_SMTP_PORT=587
EDUSYS_SMTP_USER=postmaster@edusys.ng
EDUSYS_SMTP_PASS=change-me

# Deployments: the page release.sh checks after switching (rolls back unless it answers 200)
EDUSYS_HEALTH_URL=https://edusys.ng/site/login
